### POST - Crear prospecto
POST {{baseUrl}}/v1/clients
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Empresa Nueva S.A.S",
  "nit": "900987654-3",
  "email": "info@empresanueva.com",
  "phone": "+57 300 555 1234",
  "isProspect": true,
  "observations": "Prospecto interesado en ISO 14001"
}

### PATCH - Actualizar cliente (requiere JWT)
PATCH {{baseUrl}}/v1/clients/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "phone": "+57 601 999 8888",
  "observations": "Actualizado - nuevo contacto asignado",
  "showResources": true,
  "contacts": [
    {
      "name": "Maria Torres",
      "position": "Directora de Calidad",
      "phone": "300 123 4567",
      "email": "mtorres@respaldovital.com",
      "isPrimary": true
    }
  ],
  "resources": [
    {
      "name": "Logo respaldo vital",
      "url": "https://pub-xxx.r2.dev/clients/1-logo.png",
      "type": "image",
      "uploadedAt": "2025-02-10T10:00:00Z"
    },
    {
      "name": "Certificado ISO 9001 vigente",
      "url": "https://pub-xxx.r2.dev/clients/1-certificado-vigente.pdf",
      "type": "document",
      "uploadedAt": "2025-03-15T14:30:00Z"
    }
  ]
}

### DELETE - Eliminar cliente (requiere JWT)
DELETE {{baseUrl}}/v1/clients/1
Authorization: Bearer {{token}}


# ==========================================================
# 3. COLLABORATORS
# ==========================================================

### GET - Listar todos los colaboradores (PUBLICO)
GET {{baseUrl}}/v1/collaborators

### GET - Listar colaboradores con paginacion
GET {{baseUrl}}/v1/collaborators?page=1&limit=10

### GET - Buscar colaboradores por nombre, area, ciudad o estudios
GET {{baseUrl}}/v1/collaborators?search=Camila&page=1&limit=10

### GET - Obtener colaborador por ID (requiere JWT)
GET {{baseUrl}}/v1/collaborators/1
Authorization: Bearer {{token}}

