### POST - Crear licitacion (requiere JWT)
POST {{baseUrl}}/v1/tenders
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "offerCode": "OE-LIC-001",
  "type": "publica",
  "processNumber": "SECOP-2025-00123",
  "clientName": "Ministerio de Ambiente",
  "service": "Auditoria ISO 14001",
  "norm": "ISO 14001:2015",
  "status": "publicada",
  "publicationDate": "2025-02-01",
  "closingDate": "2025-03-01",
  "estimatedValue": 50000000,
  "observations": "Licitacion publica para auditoria ambiental"
}

### PATCH - Actualizar licitacion (requiere JWT)
PATCH {{baseUrl}}/v1/tenders/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "en_curso",
  "observations": "Propuesta enviada, en espera de respuesta"
}

### DELETE - Eliminar licitacion (requiere JWT)
DELETE {{baseUrl}}/v1/tenders/1
Authorization: Bearer {{token}}


# ==========================================================
# 6. EVENTS (Timeline de eventos)
# ==========================================================

### GET - Listar todos los eventos
GET {{baseUrl}}/v1/events?page=1&limit=10

### GET - Obtener eventos de una entidad especifica
GET {{baseUrl}}/v1/events?entityType=client&entityId=1

### GET - Obtener eventos de un proyecto
GET {{baseUrl}}/v1/events?entityType=project&entityId=1

### POST - Crear evento (requiere JWT)
POST {{baseUrl}}/v1/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "entityType": "client",
  "entityId": 1,
  "type": "reunion",
  "description": "Reunion de arranque del proyecto de implementacion SG",
  "user": "Camila Rodriguez",
  "date": "2025-02-15T10:00:00Z"
}

### POST - Crear evento de llamada
POST {{baseUrl}}/v1/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "entityType": "project",
  "entityId": 1,
  "type": "llamada",
  "description": "Llamada de seguimiento - avance fase 1",
  "user": "Andres Martinez",
  "date": "2025-03-01T14:30:00Z"
}

### POST - Crear evento de visita
POST {{baseUrl}}/v1/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "entityType": "tender",
  "entityId": 1,
  "type": "visita",
  "description": "Visita tecnica al sitio de auditoria",
  "user": "Camila Rodriguez",
  "date": "2025-03-10T09:00:00Z"
}

### DELETE - Eliminar evento (requiere JWT)
DELETE {{baseUrl}}/v1/events/1
Authorization: Bearer {{token}}


# ==========================================================
# 7. DOCUMENTS (Documentos polimorficos)
# ==========================================================

### GET - Listar todos los documentos
GET {{baseUrl}}/v1/documents?page=1&limit=10

### GET - Obtener documentos de un cliente
GET {{baseUrl}}/v1/documents?entityType=client&entityId=1

### GET - Obtener documentos de un proyecto
GET {{baseUrl}}/v1/documents?entityType=project&entityId=1

### GET - Obtener documentos de una cotizacion
GET {{baseUrl}}/v1/documents?entityType=quote&entityId=1

### GET - Obtener documentos de una licitacion
GET {{baseUrl}}/v1/documents?entityType=tender&entityId=1

# Respuesta esperada:
# {
#   "success": true,
#   "data": {
#     "count": 2,
#     "documents": [
#       {
#         "id": 1,
#         "entityType": "client",
#         "entityId": 1,
#         "name": "contrato-social.pdf",
#         "type": "contrato",
#         "url": "https://pub-xxx.r2.dev/clients/1-a1b2c3.pdf",
#         "size": 245000,
#         "user": "admin@example.com",
#         "createdAt": "2025-02-10T10:00:00.000Z"
#       }
#     ]
#   }
# }

### POST - Subir documento a un cliente (requiere JWT + multipart)
POST {{baseUrl}}/v1/documents
Content-Type: multipart/form-data
Authorization: Bearer {{token}}

--form-data
entityType: client
entityId: 1
type: contrato
file: @C:/path/to/contrato-social.pdf

### POST - Subir cotizacion PDF a un proyecto (requiere JWT + multipart)
POST {{baseUrl}}/v1/documents
Content-Type: multipart/form-data
Authorization: Bearer {{token}}

--form-data
entityType: project
entityId: 1
type: cotizacion
file: @C:/path/to/cotizacion-0001-SG.pdf

### POST - Subir informe a una licitacion (requiere JWT + multipart)
POST {{baseUrl}}/v1/documents
Content-Type: multipart/form-data
Authorization: Bearer {{token}}

--form-data
entityType: tender
entityId: 1
type: informe
file: @C:/path/to/informe-auditoria.pdf

### POST - Subir hoja de vida a un cliente (requiere JWT + multipart)
POST {{baseUrl}}/v1/documents
Content-Type: multipart/form-data
Authorization: Bearer {{token}}

--form-data
entityType: client
entityId: 1
type: hoja_de_vida
file: @C:/path/to/hv-consultor.pdf

### DELETE - Eliminar documento (requiere JWT)
DELETE {{baseUrl}}/v1/documents/1
Authorization: Bearer {{token}}


# ==========================================================
# 8. FILES (Endpoint generico para subir archivos)
# ==========================================================

### POST - Subir archivo a cliente via funcFiles (requiere JWT + multipart)
POST {{baseUrl}}/v1/files/clients/1
Content-Type: multipart/form-data
Authorization: Bearer {{token}}

--form-data
files: @C:/path/to/documento.pdf

### POST - Subir archivo a proyecto via funcFiles
POST {{baseUrl}}/v1/files/projects/1
Content-Type: multipart/form-data
Authorization: Bearer {{token}}

--form-data
files: @C:/path/to/archivo-proyecto.pdf

### POST - Subir archivo a cotizacion via funcFiles
POST {{baseUrl}}/v1/files/quotes/1
Content-Type: multipart/form-data
Authorization: Bearer {{token}}

--form-data
files: @C:/path/to/cotizacion.pdf

### POST - Subir archivo a licitacion via funcFiles
POST {{baseUrl}}/v1/files/tenders/1
Content-Type: multipart/form-data
Authorization: Bearer {{token}}

--form-data
files: @C:/path/to/propuesta.pdf

### POST - Subir archivo generico (sin entidad)
POST {{baseUrl}}/v1/files/test/0
Content-Type: multipart/form-data
Authorization: Bearer {{token}}

--form-data
files: @C:/path/to/test-image.jpg

### DELETE - Eliminar archivo generico
DELETE {{baseUrl}}/v1/files/test/0/test/uuid-archivo.jpg
Authorization: Bearer {{token}}


# ==========================================================
# 9. PRODUCTS (E-commerce - CRUD)
# ==========================================================

### GET - Obtener todos los productos (paginado)
GET {{baseUrl}}/v1/products?page=1&limit=10

### GET - Obtener producto por ID
GET {{baseUrl}}/v1/products/1

### POST - Crear producto (requiere JWT)
POST {{baseUrl}}/v1/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "iPhone 15",
  "description": "Ultimo modelo de Apple",
  "price": 1200000,
  "originalPrice": 1500000,
  "images": ["https://example.com/iphone1.jpg"],
  "categoryId": 1,
  "status": "available",
  "colors": ["Negro", "Blanco", "Azul"],
  "isShowcase": true,
  "showcaseImage": "https://example.com/showcase.jpg"
}

### PATCH - Actualizar producto (requiere JWT)
PATCH {{baseUrl}}/v1/products/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "iPhone 15 Pro",
  "price": 1400000
}

### DELETE - Eliminar producto (requiere JWT)
DELETE {{baseUrl}}/v1/products/1
Authorization: Bearer {{token}}


# ==========================================================
# 10. CATEGORIES (E-commerce - CRUD)
# ==========================================================

### GET - Obtener todas las categorias
GET {{baseUrl}}/v1/categories

### GET - Obtener categoria por ID
GET {{baseUrl}}/v1/categories/1

### POST - Crear categoria (requiere JWT)
POST {{baseUrl}}/v1/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Electronica",
  "description": "Productos electronicos en general"
}

### PATCH - Actualizar categoria (requiere JWT)
PATCH {{baseUrl}}/v1/categories/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Electronica Premium"
}

### DELETE - Eliminar categoria (requiere JWT)
DELETE {{baseUrl}}/v1/categories/1
Authorization: Bearer {{token}}


# ==========================================================
# 11. PAYMENTS & ORDERS
# ==========================================================

### Crear Pago - Wompi
POST {{baseUrl}}/v1/payment/create
Content-Type: application/json

{
  "buyerEmail": "cliente@ejemplo.com",
  "buyerName": "Juan Perez",
  "buyerIdentificationNumber": "12345678",
  "buyerContactNumber": "+573001234567",
  "shippingAddress": "Calle 123 #45-67, Bogota",
  "items": [
    { "productId": 1, "quantity": 2, "selectedColor": "Azul" },
    { "productId": 3, "quantity": 1, "selectedColor": "Rojo" }
  ]
}

### Obtener Pago por ID
GET {{baseUrl}}/v1/payment/1

### Obtener Todos los Pagos
GET {{baseUrl}}/v1/payments?page=1&limit=10

### Obtener Orden por ID
GET {{baseUrl}}/v1/order/1

### Obtener Todas las Ordenes
GET {{baseUrl}}/v1/orders?page=1&limit=10

### Obtener Purchases
GET {{baseUrl}}/v1/purchases?page=1&limit=10


# ==========================================================
# 12. WEBHOOKS (Automáticos)
# ==========================================================

### Webhook Wompi
POST {{baseUrl}}/v1/webhook/wompi
Content-Type: application/json

{
  "event": "transaction.completed",
  "data": {
    "transaction": {
      "id": "txn_123456",
      "reference": "ref_payment_123",
      "status": "APPROVED",
      "amount_in_cents": 50000
    }
  }
}

### Webhook MercadoPago
POST {{baseUrl}}/v1/webhook/mercadopago
Content-Type: application/json

{
  "id": "12345678",
  "topic": "payment",
  "resource": "/v1/payments/12345678"
}


# ==========================================================
# 13. UTILITIES
# ==========================================================

### Reenviar Email
POST {{baseUrl}}/v1/purchase/resend-email
Content-Type: application/json

{
  "email": "user@example.com",
  "userId": 1
}


# ==========================================================
# NOTAS
# ==========================================================
#
# ENDPOINTS PUBLICOS (sin JWT):
#   - GET /v1/health/db
#   - POST /v1/login
#   - GET /v1/clients (listado)
#   - GET /v1/quotes (listado)
#   - GET /v1/projects (listado)
#   - GET /v1/tenders (listado)
#   - GET /v1/events (listado)
#   - GET /v1/documents (listado)
#   - POST /v1/payment/create
#   - Webhooks
#
# ENDPOINTS PROTEGIDOS (requieren JWT):
#   - POST /v1/user/create
#   - POST, PATCH, DELETE /v1/clients/{id}
#   - GET /v1/clients/{id} (individual)
#   - POST, PATCH, DELETE /v1/projects/{id}
#   - POST, PATCH, DELETE /v1/quotes/{id}
#   - POST, PATCH, DELETE /v1/tenders/{id}
#   - POST, DELETE /v1/events/{id}
#   - POST, DELETE /v1/documents/{id}
#   - POST, DELETE /v1/files/*
#   - CRUD de Products y Categories
#
# RESPUESTA ESTANDAR:
#   { "success": true, "data": {...}, "message": "...", "timestamp": "...", "statusCode": 200 }
#
# ERROR:
#   { "success": false, "message": "...", "timestamp": "...", "statusCode": 4xx/5xx }
#
# DOCUMENTOS - Flujo:
#   1. POST /v1/documents (multipart: entityType, entityId, type, file)
#   2. GET /v1/documents?entityType=client&entityId=1
#   3. DELETE /v1/documents/{id}
#
# DOCUMENTOS - Tipos validos:
#   contrato, cotizacion, informe, certificado, acta,
#   presentacion, hoja_de_vida, soportes_estudio
#
# ENTIDADES para documents/events:
#   client, project, quote, tender
