#   "timestamp": "2025-02-10T10:00:00.000Z",
#   "statusCode": 201
# }

### POST - Crear colaborador minimo (requiere JWT)
POST {{baseUrl}}/v1/collaborators
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Andres Martinez",
  "studies": "Ingeniero de Sistemas - Universidad Javeriana",
  "mainArea": "Tecnologia",
  "city": "Medellin"
}

### POST - Crear colaborador sin campos requeridos (deberia fallar 422)
POST {{baseUrl}}/v1/collaborators
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Test Incompleto"
}

### PATCH - Actualizar colaborador (requiere JWT)
PATCH {{baseUrl}}/v1/collaborators/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "phone": "300 999 8888",
  "email": "camila.nueva@ejemplo.com",
  "status": "busy",
  "city": "Medellin",
  "competencies": [
    { "area": "ISO 14001", "norm": "ISO 14001:2015", "description": "Auditor Lider certificada" },
    { "area": "ISO 45001", "norm": "ISO 45001:2018", "description": "Auditor en capacitacion" }
  ]
}

### DELETE - Eliminar colaborador (requiere JWT)
DELETE {{baseUrl}}/v1/collaborators/1
Authorization: Bearer {{token}}

### POST - Subir documento a un colaborador (requiere JWT + multipart)
POST {{baseUrl}}/v1/documents
Content-Type: multipart/form-data
Authorization: Bearer {{token}}

--form-data
entityType: collaborator
entityId: 1
type: hoja_de_vida
file: @C:/path/to/hv-consultor.pdf

### POST - Subir archivo a colaborador via funcFiles (requiere JWT + multipart)
POST {{baseUrl}}/v1/files/collaborators/1
Content-Type: multipart/form-data
Authorization: Bearer {{token}}

--form-data
files: @C:/path/to/hv-consultor.pdf

### GET - Obtener documentos de un colaborador
GET {{baseUrl}}/v1/documents?entityType=collaborator&entityId=1

### POST - Crear evento para un colaborador (requiere JWT)
POST {{baseUrl}}/v1/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "entityType": "collaborator",
  "entityId": 1,
  "type": "asignacion",
  "description": "Colaborador asignado al proyecto de implementacion ISO 9001",
  "user": "admin@example.com",
  "date": "2025-03-01T10:00:00Z"
}

### GET - Obtener eventos de un colaborador
GET {{baseUrl}}/v1/events?entityType=collaborator&entityId=1


# ==========================================================
# 4. PROJECTS
# ==========================================================

### GET - Listar todos los proyectos
GET {{baseUrl}}/v1/projects?page=1&limit=10

### GET - Buscar proyectos por descripcion, responsable, nombre del cliente o nombre de servicio
GET {{baseUrl}}/v1/projects?search=Implementacion&page=1&limit=10

### GET - Obtener proyectos de un cliente
GET {{baseUrl}}/v1/projects?clientId=1&page=1&limit=10

### GET - Obtener proyecto por ID (incluye datos del cliente)
GET {{baseUrl}}/v1/projects/1

