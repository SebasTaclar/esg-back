### POST - Crear proyecto (requiere JWT)
POST {{baseUrl}}/v1/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "clientId": 1,
  "serviceType": "Consultoria",
  "norm": "ISO 9001:2015",
  "status": "cotizacion",
  "responsible": "Camila Rodriguez",
  "startDate": "2025-02-15",
  "description": "Implementacion sistema de gestion de calidad",
  "observations": "",
  "offer": "OE-0001",
  "totalCost": 9500000,
  "services": [
    {
      "name": "Implementacion - Fase 1",
      "norm": "ISO 9001:2015",
      "quantity": 3,
      "unitPrice": 2500000,
      "subtotal": 7500000,
      "discount": 0,
      "subtotalWithDiscount": 7500000,
      "iva": 1425000,
      "totalPrice": 7500000,
      "rol": "Gerente de Proyecto",
      "collaborator": "Camila Rodriguez",
      "billingAccountNumber": "CC-001",
      "collaboratorUnitPrice": 2500000,
      "collaboratorTotalPrice": 7500000,
      "pretaxProfit": 1500000,
      "ica": 75000,
      "simpleTax": 375000,
      "netProfit": 1050000,
      "entryDate": "2025-02-15",
      "billingDate": "2025-03-15",
      "purchaseOrderDate": "2025-02-10",
      "purchaseOrderNumber": "OC-001"
    },
    {
      "name": "Capacitacion Virtual",
      "norm": "ISO 9001:2015",
      "quantity": 4,
      "unitPrice": 500000,
      "subtotal": 2000000,
      "discount": 100000,
      "subtotalWithDiscount": 1900000,
      "iva": 380000,
