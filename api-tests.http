#     "updatedAt": "2025-02-10T10:00:00.000Z"
#   }
# }

### POST - Crear cotizacion (requiere JWT)
POST {{baseUrl}}/v1/quotes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "COT-2025-001",
  "clientId": 1,
  "projectId": 1,
  "status": "pendiente",
  "totalAmount": 9500000,
  "validUntil": "2025-03-15",
  "observations": "Cotizacion para implementacion SG fase 1 y 2",
  "services": [
    {
      "name": "Implementacion - Fase 1",
      "quantity": 3,
      "billingType": "ONETIME",
      "description": "Implementacion del sistema de gestion",
      "value": 2500000
    },
    {
      "name": "Capacitacion Virtual",
      "quantity": 4,
      "billingType": "ONETIME",
      "description": "Capacitacion virtual para el equipo",
      "value": 500000
    }
  ]
}

### POST - Crear cotizacion mensual
POST {{baseUrl}}/v1/quotes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "COT-2025-002",
  "clientId": 2,
  "status": "pendiente",
  "totalAmount": 350000,
  "validUntil": "2025-04-01",
  "services": [
    {
      "name": "CRM Cloud",
      "quantity": 1,
      "billingType": "MONTHLY",
      "description": "Sistema CRM mensual",
      "value": 300000
    },
    {
      "name": "Email Marketing",
      "quantity": 1,
      "billingType": "MONTHLY",
      "description": "Plataforma de email marketing",
      "value": 50000
    }
  ]
}

### PATCH - Actualizar cotizacion (requiere JWT)
PATCH {{baseUrl}}/v1/quotes/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "enviada",
  "observations": "Cotizacion enviada al cliente por email"
}

### PATCH - Aprobar cotizacion
PATCH {{baseUrl}}/v1/quotes/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "aprobada"
}

### DELETE - Eliminar cotizacion (requiere JWT)
DELETE {{baseUrl}}/v1/quotes/1
Authorization: Bearer {{token}}


# ==========================================================
# 5. TENDERS (Licitaciones)
# ==========================================================

### GET - Listar todas las licitaciones
GET {{baseUrl}}/v1/tenders?page=1&limit=10

### GET - Buscar licitaciones por cliente o servicio
GET {{baseUrl}}/v1/tenders?search=SECOP&page=1&limit=10

### GET - Obtener licitacion por ID
GET {{baseUrl}}/v1/tenders/1

# Respuesta esperada:
# {
#   "success": true,
#   "data": {
#     "id": 1,
#     "offerCode": "OE-LIC-001",
#     "type": "publica",
#     "processNumber": "SECOP-2025-00123",
