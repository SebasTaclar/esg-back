# Requiere: @adminToken
POST {{baseUrl}}/v1/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "iPhone 15",
  "description": "Ultimo modelo de Apple",
  "price": 1200000,
  "images": ["https://example.com/iphone1.jpg"],
  "categoryId": 1,
  "status": "available"
}


