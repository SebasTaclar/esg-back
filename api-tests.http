### POST - Crear proyecto (requiere JWT)
POST {{baseUrl}}/v1/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "clientId": 1,
  "consecutive": 1,
  "abbreviation": "SG",
  "code": "0001-SG",
  "projectType": "Sistema de Gestion de Calidad",
  "serviceType": "Consultoria",
  "norm": "ISO 9001:2015",
  "status": "cotizacion",
  "responsible": "Camila Rodriguez",
  "startDate": "2025-02-15",
  "description": "Implementacion sistema de gestion de calidad",
  "observations": "",
  "offer": "OE-0001",
  "totalCost": 9500000,
  "services": [
    {
      "name": "Implementacion - Fase 1",
      "norm": "ISO 9001:2015",
      "quantity": 3,
      "unitPrice": 2500000,
      "totalPrice": 7500000,
      "collaborator": "Camila Rodriguez"
    },
    {
      "name": "Capacitacion Virtual",
      "norm": "ISO 9001:2015",
      "quantity": 4,
      "unitPrice": 500000,
      "totalPrice": 2000000,
      "collaborator": "Andres Martinez"
    }
  ]
}

### PATCH - Actualizar proyecto (requiere JWT)
PATCH {{baseUrl}}/v1/projects/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "aprobado",
  "observations": "Proyecto aprobado por el cliente",
  "endDate": "2025-08-15",
  "totalCost": 10000000
}

### DELETE - Eliminar proyecto (requiere JWT)
DELETE {{baseUrl}}/v1/projects/1
Authorization: Bearer {{token}}


# ==========================================================
# 4. QUOTES (Cotizaciones)
# ==========================================================

### GET - Listar todas las cotizaciones
GET {{baseUrl}}/v1/quotes?page=1&limit=10

### GET - Buscar cotizaciones por codigo o nombre de cliente
GET {{baseUrl}}/v1/quotes?search=COT&page=1&limit=10

### GET - Obtener cotizaciones de un cliente
GET {{baseUrl}}/v1/quotes?clientId=1&page=1&limit=10

### GET - Obtener cotizaciones de un proyecto
GET {{baseUrl}}/v1/quotes?projectId=1&page=1&limit=10

### GET - Obtener cotizacion por ID (incluye cliente y proyecto)
GET {{baseUrl}}/v1/quotes/1

# Respuesta esperada:
# {
#   "success": true,
#   "data": {
#     "id": 1,
#     "code": "COT-2025-001",
#     "clientId": 1,
#     "client": { "id": 1, "name": "RESPALDO VITAL S.A.S", "email": "...", "phone": "...", "nit": "900123456-7" },
#     "projectId": 1,
