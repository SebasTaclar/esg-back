# Authorization: Bearer {{adminToken}}
#
# {
#   "title": "Evento mal formado",
#   "entityId": 1,
#   "type": "Reunion",
#   "date": "2025-03-15T10:00:00Z",
#   "user": "Auditor Test"
# }

