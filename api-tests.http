### POST - Crear cliente (requiere JWT)
POST {{baseUrl}}/v1/clients
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "RESPALDO VITAL S.A.S",
  "nit": "900123456-7",
  "code": "0001-SG",
  "organizationType": "Sistema de Gestion de Calidad",
  "norm": "ISO 9001:2015",
  "city": "Bogota D.C.",
  "department": "Cundinamarca",
  "address": "Carrera 15 # 88-56, Oficina 502",
  "phone": "+57 601 3456789",
  "email": "contacto@respaldovital.com",
  "website": "https://respaldovital.com",
  "isActive": true,
  "isProspect": false,
  "observations": "Cliente corporativo desde 2021",
  "showResources": false,
  "contacts": [
    {
      "name": "Maria Torres",
      "position": "Gerente de Calidad",
      "phone": "300 123 4567",
      "email": "mtorres@respaldovital.com",
      "isPrimary": true
    },
    {
      "name": "Carlos Ruiz",
      "position": "Jefe de Operaciones",
      "phone": "310 987 6543",
      "email": "cruiz@respaldovital.com",
      "isPrimary": false
    }
  ],
  "resources": [
    {
      "name": "Logo respaldo vital",
      "url": "https://pub-xxx.r2.dev/clients/1-logo.png",
      "type": "image",
      "uploadedAt": "2025-02-10T10:00:00Z"
    },
    {
      "name": "Certificado ISO 9001",
      "url": "https://pub-xxx.r2.dev/clients/1-certificado.pdf",
      "type": "document",
      "uploadedAt": "2025-02-10T10:00:00Z"
    },
    {
      "name": "Fachada oficina principal",
      "url": "https://pub-xxx.r2.dev/clients/1-fachada.jpg",
      "type": "image",
      "uploadedAt": "2025-02-10T10:00:00Z"
    }
  ]
}

