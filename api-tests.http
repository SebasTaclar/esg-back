@baseUrl = http://localhost:7071/api
@adminToken = 
@clientToken = 

# ==========================================================
# ESG CRM - API Tests
# ==========================================================
# Variables:
#   @baseUrl      - URL base del backend (localhost:7071/api)
#   @adminToken   - JWT token de admin (obtener del login)
#   @clientToken  - JWT token de cliente (obtener del login)
#
# Roles:
#   admin  - Acceso completo, puede crear usuarios y asignar clients
#   user   - Solo ve los clients asociados a su userId
#
# isVisible:
#   Cada entidad CRM tiene campo boolean isVisible (default: false).
#   Admin ve todos. Client solo ve registros con isVisible: true.
#   POST/PATCH con isVisible: true/false para controlar visibilidad.
#
# Respuesta estandar:
#   { "success": true, "data": {...}, "message": "...", "timestamp": "...", "statusCode": 200 }
# ==========================================================


# ==========================================================
# 1. SEED & SETUP
# ==========================================================

### Ejecutar seed (crear admin inicial) - Ejecutar una sola vez desde terminal
# npm run db:seed

### Health Check - Verificar conexion a BD
GET {{baseUrl}}/v1/health/db


# ==========================================================
# 2. AUTH & USERS
# ==========================================================

### Login - Obtener JWT de Admin
# @name loginAdmin
POST {{baseUrl}}/v1/login
Content-Type: application/json

{
  "email": "admin@esg.com",
  "password": "Admin123!"
}

### Login - Obtener JWT de Cliente
# @name loginClient
POST {{baseUrl}}/v1/login
Content-Type: application/json

{
  "email": "cliente@ejemplo.com",
  "password": "cliente123"
}

### Crear Usuario (SOLO ADMIN)
# Requiere: @adminToken del loginAdmin
# Requiere: cambiar @targetClientId por el ID real del cliente a vincular
POST {{baseUrl}}/v1/user/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "clientId": "@targetClientId",
  "password": "cliente123"
}

### Crear Usuario - Deberia fallar sin token (401)
POST {{baseUrl}}/v1/user/create
Content-Type: application/json

{
  "clientId": 1,
  "password": "test123"
}

### Crear Usuario - Deberia fallar con rol user (403)
# Requiere: @clientToken del loginClient
POST {{baseUrl}}/v1/user/create
Content-Type: application/json
Authorization: Bearer {{clientToken}}

{
  "clientId": 1,
  "password": "test123"
}

### Crear Usuario - Deberia fallar si el clientId ya tiene usuario (409)
# Requiere: @adminToken del loginAdmin
# El cliente ya tiene un usuario asignado
POST {{baseUrl}}/v1/user/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "clientId": "@targetClientId",
  "password": "otro123"
}

### Crear Usuario - Deberia fallar si el clientId no existe (400)
# Requiere: @adminToken del loginAdmin
POST {{baseUrl}}/v1/user/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "clientId": 99999,
  "password": "test123"
}

### Crear Usuario - Deberia fallar sin clientId (422)
# Requiere: @adminToken del loginAdmin
POST {{baseUrl}}/v1/user/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "password": "test123"
}

### Crear Usuario - Deberia fallar sin password (422)
# Requiere: @adminToken del loginAdmin
POST {{baseUrl}}/v1/user/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "clientId": "@targetClientId"
}

### Crear Usuario - Deberia fallar con password muy corta (400)
# Requiere: @adminToken del loginAdmin
POST {{baseUrl}}/v1/user/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "clientId": "@targetClientId",
  "password": "123"
}


# ==========================================================
# 2.1. LIST USERS (SOLO ADMIN)
# ==========================================================

### GET - Listar todos los usuarios con clientes asociados (ADMIN)
# Requiere: @adminToken del loginAdmin
GET {{baseUrl}}/v1/users
Authorization: Bearer {{adminToken}}

### GET - Listar usuarios - Deberia fallar con rol user (403)
# Requiere: @clientToken del loginClient
GET {{baseUrl}}/v1/users
Authorization: Bearer {{clientToken}}

### GET - Listar usuarios - Deberia fallar sin token (401)
GET {{baseUrl}}/v1/users


# ==========================================================
# 2.2. CHANGE PASSWORD (SOLO ADMIN)
# ==========================================================

### PATCH - Admin cambia contraseña de usuario - Exito
# Requiere: @adminToken del loginAdmin
# Requiere: cambiar @targetUserId por el ID real del usuario
PATCH {{baseUrl}}/v1/user/change-password
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "newPassword": "nuevaClave456",
  "userId": "@targetUserId"
}

### PATCH - Cambiar contraseña - Deberia fallar sin token (401)
PATCH {{baseUrl}}/v1/user/change-password
Content-Type: application/json

{
  "newPassword": "nuevaClave456",
  "userId": "1"
}

### PATCH - Cambiar contraseña - Deberia fallar sin userId (422)
# Requiere: @adminToken del loginAdmin
PATCH {{baseUrl}}/v1/user/change-password
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "newPassword": "nuevaClave456"
}

### PATCH - Cambiar contraseña - Deberia fallar si la nueva es muy corta (422)
# Requiere: @adminToken del loginAdmin
PATCH {{baseUrl}}/v1/user/change-password
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "newPassword": "123",
  "userId": "@targetUserId"
}

### PATCH - Cambiar contraseña - Deberia fallar si la nueva es igual a la actual (400)
# Requiere: @adminToken del loginAdmin
PATCH {{baseUrl}}/v1/user/change-password
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "newPassword": "nuevaClave456",
  "userId": "@targetUserId"
}

### PATCH - Cambiar contraseña - Deberia fallar si user no es admin (403)
# Requiere: @clientToken del loginClient
PATCH {{baseUrl}}/v1/user/change-password
Content-Type: application/json
Authorization: Bearer {{clientToken}}

{
  "newPassword": "hacker123",
  "userId": "1"
}


# ==========================================================
# 2.3. DELETE USER (SOLO ADMIN)
# ==========================================================

### DELETE - Eliminar usuario - Exito
# Requiere: @adminToken del loginAdmin
# Requiere: cambiar @targetUserId por el ID real del usuario a eliminar
DELETE {{baseUrl}}/v1/users/@targetUserId
Authorization: Bearer {{adminToken}}

### DELETE - Eliminar usuario - Deberia fallar sin token (401)
DELETE {{baseUrl}}/v1/users/1

### DELETE - Eliminar usuario - Deberia fallar con rol user (403)
# Requiere: @clientToken del loginClient
DELETE {{baseUrl}}/v1/users/1
Authorization: Bearer {{clientToken}}

### DELETE - Eliminar usuario - Deberia fallar si intenta eliminarse a si mismo (400)
# Requiere: @adminToken del loginAdmin (usa el ID del propio admin)
DELETE {{baseUrl}}/v1/users/@adminUserId
Authorization: Bearer {{adminToken}}

### DELETE - Eliminar usuario - Deberia fallar con ID invalido (400)
DELETE {{baseUrl}}/v1/users/abc
Authorization: Bearer {{adminToken}}


# ==========================================================
# 3. CLIENTS (CRM) - Con Roles
# ==========================================================

### GET - Listar clients del usuario autenticado (CLIENT solo ve los suyos)
# Requiere: @clientToken
GET {{baseUrl}}/v1/clients
Authorization: Bearer {{clientToken}}

### GET - Listar TODOS los clients (ADMIN ve todos)
# Requiere: @adminToken
GET {{baseUrl}}/v1/clients
Authorization: Bearer {{adminToken}}

### GET - Listar clients con paginacion
# Requiere: @adminToken
GET {{baseUrl}}/v1/clients?page=1&limit=10
Authorization: Bearer {{adminToken}}

### GET - Buscar clients por nombre, email o NIT
# Requiere: @adminToken
GET {{baseUrl}}/v1/clients?search=juan&page=1&limit=10
Authorization: Bearer {{adminToken}}

### GET - Obtener client por ID (ADMIN)
# Requiere: @adminToken
GET {{baseUrl}}/v1/clients/1
Authorization: Bearer {{adminToken}}

### GET - Obtener client por ID (CLIENT solo ve el suyo)
# Requiere: @clientToken
GET {{baseUrl}}/v1/clients/1
Authorization: Bearer {{clientToken}}

### GET - Obtener client ajeno - Deberia fallar (403)
# Requiere: @clientToken
GET {{baseUrl}}/v1/clients/999
Authorization: Bearer {{clientToken}}

### GET - Sin token - Deberia fallar (401)
GET {{baseUrl}}/v1/clients/1

### POST - Crear client (ADMIN puede asignar userId)
# Requiere: @adminToken
POST {{baseUrl}}/v1/clients
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Empresa Nuevo Cliente S.A.S",
  "nit": "900111222-3",
  "email": "info@nuevocliente.com",
  "phone": "+57 300 555 9999",
  "isActive": true,
  "isProspect": false,
  "userId": 2,
  "isVisible": true
}

### POST - Crear client (CLIENT automaticamente se asigna a si mismo)
# Requiere: @clientToken
POST {{baseUrl}}/v1/clients
Content-Type: application/json
Authorization: Bearer {{clientToken}}

{
  "name": "Mi Empresa Personal",
  "nit": "900333444-5",
  "email": "contacto@miempresa.com",
  "phone": "+57 310 123 4567",
  "isProspect": true
}

### POST - Sin token - Deberia fallar (401)
POST {{baseUrl}}/v1/clients
Content-Type: application/json

{
  "name": "Test Sin Auth",
  "nit": "900999888-7",
  "email": "test@sinauth.com"
}

### POST - Token invalido - Deberia fallar (401)
POST {{baseUrl}}/v1/clients
Content-Type: application/json
Authorization: Bearer invalid-token-123

{
  "name": "Test Token Invalido",
  "nit": "900999888-8",
  "email": "test@tokeninvalido.com"
}

### PATCH - Asignar client a usuario (SOLO ADMIN)
# Requiere: @adminToken
PATCH {{baseUrl}}/v1/clients/1/assign-user
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "userId": 2
}

### PATCH - Desasignar client de usuario (SOLO ADMIN)
# Requiere: @adminToken
PATCH {{baseUrl}}/v1/clients/1/assign-user
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "userId": null
}

### PATCH - Asignar client - Deberia fallar con rol user (403)
# Requiere: @clientToken
PATCH {{baseUrl}}/v1/clients/1/assign-user
Content-Type: application/json
Authorization: Bearer {{clientToken}}

{
  "userId": 2
}

### PATCH - Actualizar client (CLIENT solo actualiza el suyo)
# Requiere: @clientToken
PATCH {{baseUrl}}/v1/clients/1
Content-Type: application/json
Authorization: Bearer {{clientToken}}

{
  "phone": "+57 601 999 8888",
  "observations": "Actualizado por el cliente"
}

### PATCH - Toggle isVisible de un client (SOLO ADMIN)
# Requiere: @adminToken
# PATCH {{baseUrl}}/v1/clients/1
# Content-Type: application/json
# Authorization: Bearer {{adminToken}}
#
# {
#   "isVisible": true
# }

### DELETE - Eliminar client (CLIENT solo elimina el suyo)
# Requiere: @clientToken
DELETE {{baseUrl}}/v1/clients/1
Authorization: Bearer {{clientToken}}


# ==========================================================
# 4. COLLABORATORS
# ==========================================================

### GET - Listar todos los colaboradores (requiere JWT)
# Requiere: @adminToken
GET {{baseUrl}}/v1/collaborators
Authorization: Bearer {{adminToken}}

### POST - Crear colaborador (requiere JWT)
# Requiere: @adminToken
POST {{baseUrl}}/v1/collaborators
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Camila Rodriguez",
  "studies": "Ingeniera Ambiental - Universidad Nacional",
  "mainArea": "Gestion Ambiental",
  "city": "Bogota D.C.",
  "phone": "300 123 4567",
  "email": "camila.rodriguez@ejemplo.com",
  "status": "available",
  "competencies": [
    { "area": "ISO 14001", "norm": "ISO 14001:2015", "description": "Auditor Lider certificada" },
    { "area": "ISO 9001", "norm": "ISO 9001:2015", "description": "Auditor interno" }
  ]
}

### GET - Obtener colaborador por ID (requiere JWT)
# Requiere: @adminToken
# GET {{baseUrl}}/v1/collaborators/1
# Authorization: Bearer {{adminToken}}

### PATCH - Actualizar colaborador (requiere JWT)
# Requiere: @adminToken
# PATCH {{baseUrl}}/v1/collaborators/1
# Content-Type: application/json
# Authorization: Bearer {{adminToken}}
#
# {
#   "name": "Camila Rodriguez Updated",
#   "status": "busy"
# }

### DELETE - Eliminar colaborador (requiere JWT)
# Requiere: @adminToken
# DELETE {{baseUrl}}/v1/collaborators/1
# Authorization: Bearer {{adminToken}}


# ==========================================================
# 5. PROJECTS
# ==========================================================

### GET - Listar todos los proyectos (ADMIN ve todos)
# Requiere: @adminToken
GET {{baseUrl}}/v1/projects?page=1&limit=10
Authorization: Bearer {{adminToken}}

### GET - Listar proyectos (CLIENT solo ve visibles)
# Requiere: @clientToken
# GET {{baseUrl}}/v1/projects?page=1&limit=10
# Authorization: Bearer {{clientToken}}

### GET - Obtener proyectos de un cliente
# Requiere: @adminToken
GET {{baseUrl}}/v1/projects?clientId=1&page=1&limit=10
Authorization: Bearer {{adminToken}}

### GET - Obtener proyecto por ID (ADMIN)
# Requiere: @adminToken
# GET {{baseUrl}}/v1/projects/1
# Authorization: Bearer {{adminToken}}

### GET - Obtener proyecto por ID (CLIENT solo ve visibles, 403 si no)
# Requiere: @clientToken
# GET {{baseUrl}}/v1/projects/1
# Authorization: Bearer {{clientToken}}

### POST - Crear proyecto (requiere JWT)
# Requiere: @adminToken
POST {{baseUrl}}/v1/projects
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "clientId": 1,
  "serviceType": "Consultoria",
  "norm": "ISO 9001:2015",
  "status": "cotizacion",
  "responsible": "Camila Rodriguez",
  "startDate": "2025-02-15",
  "description": "Implementacion sistema de gestion de calidad",
  "totalCost": 9500000,
  "isVisible": false
}

### POST - Crear proyecto visible para clientes
# Requiere: @adminToken
# POST {{baseUrl}}/v1/projects
# Content-Type: application/json
# Authorization: Bearer {{adminToken}}
#
# {
#   "clientId": 1,
#   "serviceType": "Auditoria",
#   "norm": "ISO 14001:2015",
#   "status": "en_progreso",
#   "responsible": "Auditor Test",
#   "startDate": "2025-03-01",
#   "description": "Proyecto SI visible para clientes",
#   "totalCost": 8000000,
#   "isVisible": true
# }

### PATCH - Toggle isVisible de un proyecto (SOLO ADMIN)
# Requiere: @adminToken
# PATCH {{baseUrl}}/v1/projects/1
# Content-Type: application/json
# Authorization: Bearer {{adminToken}}
#
# {
#   "isVisible": true
# }

### PATCH - Actualizar proyecto (SOLO ADMIN)
# Requiere: @adminToken
# PATCH {{baseUrl}}/v1/projects/1
# Content-Type: application/json
# Authorization: Bearer {{adminToken}}
#
# {
#   "status": "en_progreso",
#   "observations": "Avance al 50%"
# }

### DELETE - Eliminar proyecto (SOLO ADMIN)
# Requiere: @adminToken
# DELETE {{baseUrl}}/v1/projects/1
# Authorization: Bearer {{adminToken}}


# ==========================================================
# 6. QUOTES (Cotizaciones)
# ==========================================================

### GET - Listar todas las cotizaciones (ADMIN ve todas)
# Requiere: @adminToken
GET {{baseUrl}}/v1/quotes?page=1&limit=10
Authorization: Bearer {{adminToken}}

### GET - Listar cotizaciones (CLIENT solo ve visibles)
# Requiere: @clientToken
# GET {{baseUrl}}/v1/quotes?page=1&limit=10
# Authorization: Bearer {{clientToken}}

### GET - Buscar cotizaciones por clientName, codigo o cliente
# Requiere: @adminToken
# GET {{baseUrl}}/v1/quotes?search=Empresa&page=1&limit=10
# Authorization: Bearer {{adminToken}}

### GET - Obtener cotizacion por ID (ADMIN)
# Requiere: @adminToken
# GET {{baseUrl}}/v1/quotes/1
# Authorization: Bearer {{adminToken}}

### GET - Obtener cotizacion por ID (CLIENT solo ve visibles, 403 si no)
# Requiere: @clientToken
# GET {{baseUrl}}/v1/quotes/1
# Authorization: Bearer {{clientToken}}

### GET - Cotizaciones por clientId
# Requiere: @adminToken
# GET {{baseUrl}}/v1/quotes?clientId=1&page=1&limit=10
# Authorization: Bearer {{adminToken}}

### GET - Cotizaciones por projectId
# Requiere: @adminToken
# GET {{baseUrl}}/v1/quotes?projectId=1&page=1&limit=10
# Authorization: Bearer {{adminToken}}

### POST - Crear cotizacion con clientId (clientName se obtiene de la BD)
# Requiere: @adminToken
POST {{baseUrl}}/v1/quotes
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "code": "COT-2025-001",
  "clientId": 1,
  "projectId": 1,
  "status": "pendiente",
  "totalAmount": 9500000,
  "validUntil": "2025-03-15",
  "isVisible": false,
  "services": [
    {
      "name": "Implementacion - Fase 1",
      "quantity": 3,
      "billingType": "ONETIME",
      "value": 2500000
    }
  ]
}

### POST - Crear cotizacion standalone con clientName (sin clientId)
# Requiere: @adminToken
POST {{baseUrl}}/v1/quotes
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "code": "COT-STANDALONE-001",
  "clientName": "Empresa sin registro",
  "status": "pendiente",
  "totalAmount": 5000000,
  "validUntil": "2025-06-30",
  "isVisible": false,
  "services": [
    {
      "name": "Servicio standalone",
      "quantity": 1,
      "billingType": "ONETIME",
      "value": 5000000
    }
  ]
}

### POST - Crear cotizacion con clientId inexistente - Deberia fallar (404)
# Requiere: @adminToken
POST {{baseUrl}}/v1/quotes
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "code": "COT-INV-001",
  "clientId": 99999,
  "status": "pendiente",
  "totalAmount": 3000000,
  "services": [
    {
      "name": "Servicio test",
      "quantity": 1,
      "billingType": "ONETIME",
      "value": 3000000
    }
  ]
}

### POST - Crear cotizacion visible para clientes
# Requiere: @adminToken
POST {{baseUrl}}/v1/quotes
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "code": "COT-VIS-001",
  "clientId": 1,
  "status": "aprobada",
  "totalAmount": 3000000,
  "validUntil": "2025-06-30",
  "isVisible": true,
  "services": [
    {
      "name": "Servicio visible",
      "quantity": 1,
      "billingType": "ONETIME",
      "value": 3000000
    }
  ]
}

### PATCH - Toggle isVisible de una cotizacion (SOLO ADMIN)
# Requiere: @adminToken
PATCH {{baseUrl}}/v1/quotes/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "isVisible": true
}

### PATCH - Actualizar clientName de una cotizacion
# Requiere: @adminToken
# PATCH {{baseUrl}}/v1/quotes/1
# Content-Type: application/json
# Authorization: Bearer {{adminToken}}
#
# {
#   "clientName": "Nuevo nombre del cliente"
# }

### DELETE - Eliminar cotizacion (SOLO ADMIN)
# Requiere: @adminToken
DELETE {{baseUrl}}/v1/quotes/1
Authorization: Bearer {{adminToken}}


