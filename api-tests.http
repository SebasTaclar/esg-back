# ==========================================================
# 8. EVENTS (Timeline de eventos)
# ==========================================================

### GET - Listar todos los eventos (ADMIN ve todos)
# Requiere: @adminToken
GET {{baseUrl}}/v1/events?page=1&limit=10
Authorization: Bearer {{adminToken}}

### GET - Listar eventos (CLIENT solo ve visibles)
# Requiere: @clientToken
# GET {{baseUrl}}/v1/events?page=1&limit=10
# Authorization: Bearer {{clientToken}}

### GET - Eventos por entityType y entityId
# Requiere: @adminToken
# GET {{baseUrl}}/v1/events?entityType=client&entityId=1
# Authorization: Bearer {{adminToken}}

### POST - Crear evento asociado a entidad (requiere JWT)
# Requiere: @adminToken
POST {{baseUrl}}/v1/events
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Reunion de arranque SG",
  "entityType": "client",
  "entityId": 1,
  "type": "Reunion",
  "description": "Reunion de arranque del proyecto",
  "date": "2025-02-15T10:00:00Z",
  "user": "Camila Rodriguez",
  "isVisible": false
}

### POST - Crear evento standalone (sin asociacion a entidad)
# Requiere: @adminToken
# POST {{baseUrl}}/v1/events
# Content-Type: application/json
# Authorization: Bearer {{adminToken}}
#
# {
#   "title": "Capacitacion interna",
#   "type": "Capacitacion",
#   "description": "Capacitacion en normativa ISO",
#   "date": "2025-03-20T14:00:00Z",
#   "user": "Auditor Test",
#   "isVisible": true
# }

### POST - Crear evento visible para clientes
# Requiere: @adminToken
# POST {{baseUrl}}/v1/events
# Content-Type: application/json
# Authorization: Bearer {{adminToken}}
#
# {
#   "title": "Reunion visible para cliente",
#   "entityType": "client",
#   "entityId": 1,
#   "type": "Reunion",
#   "description": "Evento que el cliente puede ver",
#   "date": "2025-03-15T10:00:00Z",
#   "user": "Auditor Test",
#   "isVisible": true
# }

### POST - Crear evento solo entityType sin entityId - Deberia fallar (422)
# Requiere: @adminToken
# POST {{baseUrl}}/v1/events
# Content-Type: application/json
# Authorization: Bearer {{adminToken}}
#
# {
#   "title": "Evento mal formado",
#   "entityType": "client",
#   "type": "Reunion",
#   "date": "2025-03-15T10:00:00Z",
#   "user": "Auditor Test"
# }

