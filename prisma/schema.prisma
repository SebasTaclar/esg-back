generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  password       String
  name           String
  role           String
  membershipPaid Boolean  @default(false) @map("membership_paid")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  clients        Client[]

  @@map("users")
}

model Purchase {
  id                        Int           @id @default(autoincrement())
  buyerEmail                String        @map("buyer_email")
  buyerName                 String        @map("buyer_name")
  buyerIdentificationNumber String        @map("buyer_identification_number")
  buyerContactNumber        String        @map("buyer_contact_number")
  shippingAddress           String?       @map("shipping_address")
  status                    String        @default("PENDING")
  orderStatus               String        @default("PENDING") @map("order_status")
  mercadopagoPaymentId      String?       @map("mercadopago_payment_id")
  preferenceId              String        @map("preference_id")
  externalReference         String        @map("external_reference")
  amount                    Int           @default(15000)
  currency                  String        @default("COP")
  paymentProvider           String?       @map("payment_provider")
  wompiTransactionId        String?       @map("wompi_transaction_id")
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")
  orderDetails              OrderDetail[]

  @@map("purchases")
}

model OrderDetail {
  id            Int      @id @default(autoincrement())
  purchaseId    Int      @map("purchase_id")
  productName   String   @map("product_name")
  quantity      Int      @default(1)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice    Decimal  @map("total_price") @db.Decimal(10, 2)
  selectedColor String?  @map("selected_color")
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("order_details")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @map("original_price") @db.Decimal(10, 2)
  images        String
  categoryId    Int      @map("category_id")
  status        String   @default("available")
  colors        String?
  isShowcase    Boolean  @default(false) @map("is_showcase")
  showcaseImage String?  @map("showcase_image")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  category      Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId], map: "idx_products_category")
  @@index([isShowcase], map: "idx_products_showcase")
  @@map("products")
}

model Client {
  id               Int       @id @default(autoincrement())
  name             String
  nit              String
  code             String?
  organizationType String?   @map("organization_type")
  norm             String?
  city             String?
  department       String?
  address          String?
  phone            String?
  email            String
  website          String?
  isActive         Boolean   @default(true) @map("is_active")
  isProspect       Boolean   @default(false) @map("is_prospect")
  observations     String?
  showResources    Boolean   @default(false) @map("show_resources")
  isVisible        Boolean   @default(false) @map("is_visible")
  contacts         Json?
  resources        Json?
  userId           Int?      @map("user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  projects         Project[]
  quotes           Quote[]
  user             User?     @relation(fields: [userId], references: [id])

  @@index([email], map: "idx_clients_email")
  @@index([nit], map: "idx_clients_nit")
  @@index([isActive], map: "idx_clients_is_active")
  @@index([isProspect], map: "idx_clients_is_prospect")
  @@index([userId], map: "idx_clients_user_id")
  @@index([isVisible], map: "idx_clients_is_visible")
  @@map("clients")
}

model Project {
  id           Int       @id @default(autoincrement())
  clientId     Int       @map("client_id")
  serviceType  String?   @map("service_type")
  norm         String?
  status       String
  responsible  String
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  description  String
  observations String?
  offer        String?
  totalCost    Decimal?  @map("total_cost") @db.Decimal(12, 2)
  services     Json?
  isVisible    Boolean   @default(false) @map("is_visible")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  client       Client    @relation(fields: [clientId], references: [id])
  quotes       Quote[]

  @@index([clientId], map: "idx_projects_client_id")
  @@index([status], map: "idx_projects_status")
  @@index([isVisible], map: "idx_projects_is_visible")
  @@map("projects")
}

model Quote {
  id           Int       @id @default(autoincrement())
  code         String?
  clientId     Int?      @map("client_id")
  clientName   String?   @map("client_name")
  projectId    Int?      @map("project_id")
  status       String    @default("pendiente")
  totalAmount  Decimal   @map("total_amount") @db.Decimal(15, 2)
  validUntil   DateTime? @map("valid_until")
  observations String?
  services     Json
  isVisible    Boolean   @default(false) @map("is_visible")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project      Project?  @relation(fields: [projectId], references: [id])

  @@index([clientId], map: "idx_quotes_client_id")
  @@index([projectId], map: "idx_quotes_project_id")
  @@index([status], map: "idx_quotes_status")
  @@index([isVisible], map: "idx_quotes_is_visible")
  @@map("quotes")
}

model Tender {
  id              Int       @id @default(autoincrement())
  offerCode       String?   @map("offer_code")
  type            String
  processNumber   String?   @map("process_number")
  clientName      String    @map("client_name")
  service         String
  norm            String?
  status          String
  publicationDate DateTime  @map("publication_date")
  closingDate     DateTime? @map("closing_date")
  estimatedValue  Decimal?  @map("estimated_value") @db.Decimal(12, 2)
  serviceItems    Json?     @map("service_items")
  observations    String?
  isVisible       Boolean   @default(false) @map("is_visible")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status], map: "idx_tenders_status")
  @@index([type], map: "idx_tenders_type")
  @@index([isVisible], map: "idx_tenders_is_visible")
  @@map("tenders")
}

model Event {
  id              Int       @id @default(autoincrement())
  title           String?                                  @map("title")
  entityType      String?                                 @map("entity_type")
  entityId        Int?                                    @map("entity_id")
  client          String?
  type            String
  typeOtro        String?   @map("type_otro")
  date            DateTime
  endDate         DateTime? @map("end_date")
  modalidad       String?
  modalidadOtro   String?   @map("modalidad_otro")
  location        String?
  personaContacto String?   @map("persona_contacto")
  user            String
  userOtro        String?   @map("user_otro")
  leadAuditor     String?   @map("lead_auditor")
  coAuditors      String?   @map("co_auditors")
  normas          String?
  description     String?
  isVisible       Boolean   @default(false) @map("is_visible")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId], map: "idx_events_entity")
  @@index([date], map: "idx_events_date")
  @@index([isVisible], map: "idx_events_is_visible")
  @@map("events")
}

model Document {
  id         Int      @id @default(autoincrement())
  entityType String?  @map("entity_type")
  entityId   Int?     @map("entity_id")
  name       String
  type       String?
  url        String
  size       Int?
  user       String
  isVisible  Boolean  @default(false) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@index([entityType, entityId], map: "idx_documents_entity")
  @@index([isVisible], map: "idx_documents_is_visible")
  @@map("documents")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model base_clientes_esg {
  C_digo_Cliente               String? @map("Código Cliente")
  Razon_Social_Persona_Natural String? @map("Razon Social;Persona Natural")
  NIT                          String?
  Ciudad                       String?
  Departamento                 String?
  Direcci_n                    String? @map("Dirección")
  Nombre                       String?
  Telefono                     String?
  Correo                       String?
  Significado                  String?
  Norma                        String?

  @@ignore
}

model Collaborator {
  id           Int      @id @default(autoincrement())
  name         String
  studies      String
  mainArea     String   @map("main_area")
  city         String
  phone        String?
  email        String?
  status       String   @default("available")
  competencies Json?
  documents    Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("collaborators")
}
